# Copy to .env (make setup does it) and change the passwords.

# Name of the house seller (the marketplace itself), seller id 1. Applied when the catalog is
# first created; to rename it later use: make cli ARGS="seller rename OLD NEW".
HOUSE_SELLER_NAME=VTEX

# PostgreSQL credentials (superuser, schema owner used by migrations/CLI, read-only API role).
POSTGRES_PASSWORD=change-me-postgres
CATALOG_OWNER_PASSWORD=change-me-owner
CATALOG_READER_PASSWORD=change-me-reader

# Published ports.
API_PORT=8000
UI_PORT=8080

# Host paths: directory mounted read-only at /imports for `make import`, legacy SQLite file.
IMPORT_DIR=./data
LEGACY_SQLITE=./data/catalog.db

# Seller product id (UUID) validation: lenient | strict, and the allowed UUID versions.
ID_VALIDATION_MODE=lenient
ID_ALLOWED_VERSIONS=4,7

# Logging and optional cross-origin access to the API (GET only), comma separated.
LOG_LEVEL=INFO
CORS_ORIGINS=
