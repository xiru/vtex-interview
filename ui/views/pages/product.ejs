<%- include('../partials/header') %>
<h1 class="h3"><%= product.name %>
  <% if (!product.active) { %><span class="badge text-bg-secondary">inactive</span><% } %>
</h1>
<dl class="row">
  <dt class="col-sm-2">Id</dt><dd class="col-sm-10"><%= product.id %></dd>
  <dt class="col-sm-2">UUID</dt><dd class="col-sm-10"><code><%= product.uuid %></code></dd>
  <dt class="col-sm-2">Brand</dt>
  <dd class="col-sm-10"><% if (product.brand) { %><a href="/brands/<%= product.brand.id %>"><%= product.brand.name %></a><% } else { %>—<% } %></dd>
  <dt class="col-sm-2">Categories</dt>
  <dd class="col-sm-10"><% for (const c of product.categories) { %><a class="badge text-bg-light text-decoration-none" href="/categories/<%= c.id %>"><%= c.name %></a> <% } %></dd>
  <% if (product.merged_into_id) { %>
    <dt class="col-sm-2">Merged into</dt><dd class="col-sm-10"><a href="/products/<%= product.merged_into_id %>?show_inactive=1">product <%= product.merged_into_id %></a></dd>
  <% } %>
  <dt class="col-sm-2">Created</dt><dd class="col-sm-10"><%= formatDate(product.created) %></dd>
</dl>
<h2 class="h5 mt-4">Offers (as each seller describes it)</h2>
<table class="table table-sm">
  <thead><tr><th>Seller</th><th>Seller's id</th><th>Name</th><th>Brand</th><th>Category</th><th>Updated</th></tr></thead>
  <tbody>
  <% for (const o of product.offers) { %>
    <tr class="<%= o.active ? '' : 'table-secondary' %>">
      <td><a href="<%= sellerPath(o.seller.name) %>"><%= o.seller.name %></a></td>
      <td><code class="small"><%= o.seller_product_id %></code></td>
      <td><%= o.name %></td><td><%= o.brand_name ?? '—' %></td><td><%= o.category_name ?? '—' %></td>
      <td class="small"><%= formatDate(o.updated) %></td>
    </tr>
  <% } %>
  </tbody>
</table>
<%- include('../partials/footer') %>
